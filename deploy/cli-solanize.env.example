# /opt/solanize/cli-solanize.env — secrets and host settings for cli-solanize.
# deploy/update.sh creates it from this file on first deploy (mode 600) with a
# random CLI_INTERNAL_SECRET, and never overwrites it afterwards.

# Loopback port; nginx (deploy/nginx-api.ribh.io.conf) proxies api.ribh.io here.
ROCKET_PORT=9876

# Bearer secret for gateway-solanize. Generated on first deploy.
CLI_INTERNAL_SECRET=

# api0 → cli-solanize (Google OIDC). Both empty → only the secret above works.
# api0 signs as its own service account with an audience scoped to the tenant:
#   https://api.ribh.io/api0/tenant/<solanize tenant id>
# so only the solanize tenant's calls are accepted.
SOLANIZE_OIDC_AUDIENCE=
# Comma-separate two during a key rotation (api0 caches signed tokens ~1 h).
SOLANIZE_OIDC_SERVICE_ACCOUNT=

# Optional private RPCs; the public mainnet one is heavily rate-limited.
# SOLANIZE_RPC_URL_MAINNET=
# SOLANIZE_RPC_URL_DEVNET=

# Jupiter (swap, price, token search, wallet token names). One key for the
# whole backend — it is solanize's quota, not a user's. Empty → keyless tier
# (lite-api.jup.ag), shared with everyone else and rate-limited.
# Get one at https://developers.jup.ag
JUPITER_API_KEY=
